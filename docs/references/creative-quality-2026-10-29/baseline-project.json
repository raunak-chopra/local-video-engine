{
  "version": 1,
  "id": "creative-quality-baseline",
  "title": "Existing scene samples combined for QA",
  "fps": 30,
  "brand": {
    "background": "#06101c",
    "foreground": "#f8fbff",
    "accent": "#62e7ff"
  },
  "scenes": [
    {
      "id": "hook",
      "type": "hook",
      "durationSec": 3,
      "props": {
        "eyebrow": "Demo product",
        "headline": "One clear idea. Zero fuss."
      }
    },
    {
      "id": "benefit",
      "type": "statement",
      "durationSec": 3,
      "props": {
        "eyebrow": "Placeholder benefit",
        "text": "Change the copy in JSON and re-render in any shape."
      }
    },
    {
      "id": "stat",
      "type": "stat",
      "durationSec": 3,
      "props": {
        "value": "1,250+",
        "label": "Placeholder metric",
        "detail": "Replace with a verified number."
      }
    },
    {
      "id": "list",
      "type": "list",
      "durationSec": 3,
      "props": {
        "headline": "Three points",
        "items": [
          "Brand fonts and colors",
          "Frame-perfect timing",
          "Rendered locally"
        ]
      }
    },
    {
      "id": "compare",
      "type": "compare",
      "durationSec": 3,
      "props": {
        "headline": "Before and after",
        "left": {
          "label": "Before",
          "text": "Hand-edited timelines"
        },
        "right": {
          "label": "After",
          "text": "One JSON, rendered in minutes"
        }
      }
    },
    {
      "id": "chart",
      "type": "chart",
      "durationSec": 3,
      "props": {
        "headline": "Example chart",
        "unit": "%",
        "bars": [
          {
            "label": "Option A",
            "value": 38
          },
          {
            "label": "Option B",
            "value": 64
          },
          {
            "label": "Option C",
            "value": 91
          }
        ],
        "source": "Placeholder data"
      }
    },
    {
      "id": "quote",
      "type": "quote",
      "durationSec": 3,
      "props": {
        "quote": "Placeholder quote from an approved source.",
        "attribution": "Name, Role"
      }
    },
    {
      "id": "end",
      "type": "endCard",
      "durationSec": 3,
      "props": {
        "title": "Demo Brand",
        "cta": "Learn more",
        "url": "example.com"
      }
    }
  ],
  "captions": [],
  "canvas": "vertical"
}
