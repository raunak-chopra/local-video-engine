{
  "version": 1,
  "id": "motion-study",
  "title": "Directed motion mechanics study",
  "canvas": "square",
  "fps": 30,
  "brand": {"background": "#101820", "foreground": "#F7F4EA", "accent": "#E8B44C"},
  "scenes": [
