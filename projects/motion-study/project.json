    {"id": "proof", "type": "list", "durationSec": 2, "motion": {"enter": "cut", "exit": "fade"}, "props": {"headline": "Review the actual frames.", "items": ["Opening and boundaries", "Reading hold", "Final frame"]}},
    {"id": "payoff", "type": "endCard", "durationSec": 2, "motion": {"enter": "cut", "exit": "cut"}, "props": {"title": "One clear idea.", "cta": "Then the next."}}
  ]
